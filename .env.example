# ─── Nebius Token Factory (LLM inference) ───
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# ─── Nebius Sandbox (code execution) ───
NEBIUS_SANDBOX_URL=https://api.tokenfactory.nebius.com/sandboxes
NEBIUS_PROJECT_ID=your-nebius-project-id
SANDBOX_BACKEND=docker
# SANDBOX_BACKEND options: "nebius" or "docker"

# ─── NVIDIA NIM (alternative direct access) ───
NVIDIA_API_KEY=your-nvidia-api-key

# ─── Tavily (documentation grounding) ───
TAVILY_API_KEY=tvly-your-tavily-api-key

# ─── GitHub ───
GITHUB_TOKEN=ghp_your-github-token
GITHUB_REPO=owner/repo-name

# ─── Server ───
HOST=0.0.0.0
PORT=3000
RUST_LOG=info,governed_coding_agent=debug
